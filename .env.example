# انسخ الملف ده لـ .env محليًا، أو حط نفس القيم في Vercel → Project Settings → Environment Variables

# مطلوب
FIREBASE_URL=https://YOUR-PROJECT.firebaseio.com
# أو
# FIREBASE_URL=https://YOUR-PROJECT.firebasedatabase.app

# أدمن اللوحة
ADMIN_USER=admin
ADMIN_PASSWORD=غيّر-الباسورد-ده

# كود / كوكي ثناويكا (واحد منهم يكفي)
THANAWICA_CODE=
# أو حط الكوكي في ملف thanawica_cookies.txt (موجود في المشروع)
# THANAWICA_COOKIES=student_session=...; student_code=...

# تفعيل ثناويكا (1 = شغال)
THANAWICA_ENABLED=1

# توكن Coursatk لو عندك
COURSATK_TOKEN=

# اختياري
# UPSTREAM_PROXY=
# UPSTREAM_RELAY_URL=
# RELAY_SECRET=
# PORT=3000
